<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ADR-0014, amendment of 2026-08-30: the .NET 11 SDK compiles
         this (global.json), and the target framework is owned by whoever
         loads the assembly. This one loads into pwsh 7.7, the floor, which
         hosts .NET 11 (amendment 2026-11-02). -->
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Xmip.PowerShell</RootNamespace>
    <AssemblyName>Xmip.PowerShell</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- A binary module is loaded by pwsh from its own directory, and pwsh
         resolves nothing from NuGet: every assembly the module needs — the
         TOML reader, the configuration abstractions —
         must lie beside it. A library build copies none of them by default,
         and the prompt said [Xmip unavailable] for a document it could not
         read (the owner, 2026-09-15). -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-time surface only: PowerShell 7's own SDK, not
         PowerShellStandard.Library, which is Windows PowerShell 5.1's
         surface and Xmip does not support 5.1 (ADR-0021). pwsh provides
         the real assemblies and their native libraries at run time, which
         is why only the compile assets are taken and nothing of the SDK is
         ever copied to the output. -->
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.7.0-rc.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>compile</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The C ABI, bound once. Xmip.Abi in xmip-core-abi declares the two
         headers for every surface — this module, the cli and the GUI — so
         nothing here crosses the boundary on its own (ADR-0014, amendment of
         2026-08-26). A sibling in the estate, not vendored: the path is the
         estate's layout, five levels up from this project. -->
    <ProjectReference Include="..\..\..\..\..\foundation\abi\dotnet\Xmip.Abi\Xmip.Abi.csproj" />
    <ProjectReference Include="..\..\..\..\..\foundation\abi\dotnet\Xmip.Surface\Xmip.Surface.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Xmip.PowerShell.psd1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Xmip.PowerShell.psm1" CopyToOutputDirectory="PreserveNewest" />
    <!-- The table views, one per operator object (ADR-0014). -->
    <None Include="Xmip.PowerShell.Format.ps1xml" CopyToOutputDirectory="PreserveNewest" />
    <!-- The surface the prompt follows is stated here, beside the module,
         never guessed (ADR-0052 clause 3). -->
    <None Update="powershell.xmip" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
