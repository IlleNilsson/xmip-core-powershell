<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ADR-0014, amendment of 2026-08-30: the .NET 11 preview SDK compiles
         this (global.json), and the target framework is owned by whoever
         loads the assembly. This one loads into pwsh 7.6.5, which hosts
         .NET 10 — proven by Import-Module refusing the net11.0 build. The
         cli, an executable that owns its runtime, targets net11.0. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Xmip.PowerShell</RootNamespace>
    <AssemblyName>Xmip.PowerShell</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-time surface only. pwsh provides the real assembly at run
         time, which is why this is never copied to the output. -->
    <PackageReference Include="PowerShellStandard.Library" Version="5.1.1">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The C ABI, bound once. Xmip.Abi in xmip-core-abi declares the two
         headers for every surface — this module, the cli and the GUI — so
         nothing here crosses the boundary on its own (ADR-0014, amendment of
         2026-08-26). A sibling in the estate, not vendored: the path is the
         estate's layout, four levels up from this project. -->
    <ProjectReference Include="..\..\..\..\foundation\abi\dotnet\Xmip.Abi\Xmip.Abi.csproj" />
    <ProjectReference Include="..\..\..\..\foundation\abi\dotnet\Xmip.Surface\Xmip.Surface.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Xmip.PowerShell.psd1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Xmip.PowerShell.psm1" CopyToOutputDirectory="PreserveNewest" />
    <!-- The surface the prompt follows is stated here, beside the module,
         never guessed (ADR-0052 clause 3). -->
    <None Update="xmip.powershell.toml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
